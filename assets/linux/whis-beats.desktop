[Desktop Entry]
Type=Application
Name=WHIS BEATS
GenericName=Music Player
Comment=A native music streaming client, built with Rust and GPUI
Icon=whis-beats
Exec=whis-beats %U
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;spotify;audio;player;
MimeType=x-scheme-handler/whis-beats;x-scheme-handler/spotify;x-scheme-handler/deezer;x-scheme-handler/tidal;audio/mpeg;audio/flac;audio/mp4;audio/aac;audio/ogg;audio/opus;audio/x-wav;audio/x-aiff;audio/webm;audio/x-matroska;audio/x-wavpack;audio/x-ape;
StartupWMClass=whis-beats
StartupNotify=true
